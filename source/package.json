  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:unit": "node tests/run-unit.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "test:regression": "node tests/run-regression.mjs",
