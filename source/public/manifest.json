{
  "manifest_version": 3,
  "name": "JobClaw by Chris 求职助手",
  "version": "1.2.37",
  "version_name": "1.2.37 GitHub Release",
  "description": "面向求职者的 BOSS 直聘 AI 应聘助手，支持职业画像后自主选择投递方向、人工确认、全自动投递、岗位排序、失败重试与 OpenClaw 桌面桥接",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "notifications",
    "unlimitedStorage",
    "scripting",
    "debugger",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://app.zhipin.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:17899/*",
    "http://localhost:17899/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 JobClaw"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://app.zhipin.com/*"
      ],
      "js": [
        "content-v37.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  }
}
