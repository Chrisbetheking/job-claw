{
  "manifest_version": 3,
  "name": "JobClaw by Chris 求职助手",
  "version": "1.7.0",
  "version_name": "1.7.0 Formal · Safe Mass Apply and OpenClaw Daily Report",
  "description": "本地优先的AI求职助手 支持精准投递与安全海投 自适应限速 企业风险核验 OpenClaw双通道连接 每日汇报 更新提醒 去重与失败恢复",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "notifications",
    "nativeMessaging",
    "unlimitedStorage",
    "scripting",
    "debugger",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://app.zhipin.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:17899/*",
    "http://localhost:17899/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 JobClaw",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://app.zhipin.com/*"
      ],
      "js": [
        "content-v37.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  },
  "short_name": "JobClaw",
  "homepage_url": "https://github.com/Chrisbetheking/job-claw",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon128.png"
  }
}
